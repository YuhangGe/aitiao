# AI 大模型配置（研发调试用）
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会提交到仓库。
# 在 CI 中构建时，不提供 .env 则不会预设默认值。
#
# DeepSeek 视觉模型：deepseek-flash 支持图片输入；
# deepseek-v4-pro 不支持图片，不要用于本项目。
# DeepSeek 的 thinking 默认开启，AdDetector 会对 api.deepseek.com 自动关闭 thinking。
# Base URL 不要带 /v1，项目会自动拼 /chat/completions。

AITIAO_MODEL_ID=deepseek-flash
AITIAO_BASE_URL=https://api.deepseek.com
AITIAO_API_KEY=sk-your-deepseek-key-here
